# Streamlit secrets 템플릿 — 이 파일은 저장소에 올라간다. 값은 비워 둔다.
#
# 실제 키는 여기 적지 않는다. 두 곳에만 넣는다.
#   로컬  : 이 폴더에 secrets.toml 로 복사해 채운다 (.gitignore가 막고 있다)
#   배포  : share.streamlit.io → 앱 → Settings → Secrets 에 붙여 넣는다
#
# 값은 GCP 콘솔에서 받은 서비스 계정 JSON의 필드를 그대로 옮긴 것이다.
# private_key는 줄바꿈이 \n 문자 그대로 들어가야 하며, 큰따옴표로 감싼다.
#
# 이 절이 없으면 앱은 로컬 ADC(gcloud auth application-default login)를 쓴다.
# 즉 로컬에서는 이 파일 없이도 그대로 돌아간다.

# ── 경로 B · 키 없이 배포 ─────────────────────────────────────────────
# 서비스 계정을 만들지 않고 배포할 때는 아래 한 줄만 넣는다. 아래 [gcp_service_account]
# 절은 통째로 지워도 된다. 배포본은 BigQuery에 연결하지 않고 흐름만 보여주며,
# 화면에 "숫자는 전부 가짜"라는 배너가 계속 뜬다 (CLAUDE.md 5-6).
#
# demo_mode = true


# ── 경로 A · 서비스 계정으로 실제 계산 ────────────────────────────────
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
